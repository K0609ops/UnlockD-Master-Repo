# =============================================
# FINVERSE — Backend Environment Variables
# Copy this to .env and fill in your values.
# =============================================

# --- PostgreSQL Database ---
DATABASE_URL=postgresql+asyncpg://finverse:finverse@db:5432/finverse

# --- Firebase Admin SDK ---
# Get from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key value (the multi-line one) — wrap in quotes
FIREBASE_PRIVATE_KEY=

# --- Gemini AI (for backend AI features) ---
GEMINI_API_KEY=
